{
  "id": "desktop-launcher",
  "name": "启动台",
  "version": "1.0.0",
  "description": "桌面快捷启动面板，支持应用与工具启动",
  "author": "OrbiBoard",
  "type": "component",
  "entry": "widgets/launcher/index.html",
  "group": "desktop_widget",
  "icon": "ri-rocket-2-line",
  "recommendedSize": {
    "width": 380,
    "height": 280
  },
  "configSchema": {
    "buttons": {
      "type": "array",
      "title": "快捷按钮",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "title": "名称" },
          "icon": { "type": "string", "title": "图标" },
          "actionType": { "type": "string", "enum": ["plugin", "app", "key"], "title": "动作类型" },
          "actionPayload": { "type": "object", "title": "动作参数" }
        }
      }
    },
    "apps": {
      "type": "array",
      "title": "桌面应用",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "title": "名称" },
          "path": { "type": "string", "title": "路径" },
          "icon": { "type": "string", "title": "图标" }
        }
      }
    }
  },
  "actions": [
    {
      "id": "openSettings",
      "text": "打开设置",
      "icon": "ri-settings-3-line",
      "target": "openSettings"
    }
  ],
  "enabled": true,
  "npmDependencies": {
    "drivelist": "^12.0.2",
    "check-disk-space": "^3.4.0"
  },
  "dependencies": [
    {
      "id": "desktop-widgets"
    }
  ]
}
